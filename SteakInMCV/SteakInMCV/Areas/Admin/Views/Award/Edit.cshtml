@model AwardEditVM

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Award Edit</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <form method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                <div class="form-group">
                                    <label for="Name">Name</label>
                                    <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" />
                                    <span class="text-danger" asp-validation-for="Name"></span>
                                </div>

                                <div class="form-group">
                                    <label for="Year">Year</label>
                                    <input type="text" class="form-control" id="Year" name="Year" value="@Model.Year" />

                                    <span class="text-danger" asp-validation-for="Year"></span>
                                </div>

                                <button type="submit" class="btn btn-primary">Save</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © SteakIn - Theme by <b>Admin</b>
                </div>
            </div>
        </div>
    </footer>
</div>
