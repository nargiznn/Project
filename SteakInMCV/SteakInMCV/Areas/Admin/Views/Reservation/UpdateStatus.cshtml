@using SteakInMCV.Models.Enum
@model SteakInMCV.Areas.Admin.ViewModels.Reservation.ReservationViewModel

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="javascript: void(0);">Velonic</a></li>
                                <li class="breadcrumb-item"><a href="javascript: void(0);">Tables</a></li>
                                <li class="breadcrumb-item active">Reservation Detail</li>
                            </ol>
                        </div>
                        <h4 class="page-title">Reservation Detail</h4>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="header-title">Reservation Details</h4>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Name</label>
                                <p>@Model.Name @Model.Surname</p>
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <p>@Model.Email</p>
                            </div>
                            <div class="form-group">
                                <label>Phone Number</label>
                                <p>@Model.PhoneNumber</p>
                            </div>
                            <div class="form-group">
                                <label>Reservation Date</label>
                                <p>@Model.Date.ToShortDateString() @Model.Time</p>
                            </div>
                            <div class="form-group">
                                <label>People Count</label>
                                <p>@Model.PeopleCount</p>
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <p>@Model.Status</p>
                            </div>
                            <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id">
                                <div class="form-group">
                                    <label for="status">Update Status</label>
                                    <select asp-for="Status" class="form-control">
                                        <option value="@ReservationStatus.Pending"
                                                selected="@(Model.Status == ReservationStatus.Pending ? "selected" : "")">
                                            Pending
                                        </option>
                                        <option value="@ReservationStatus.Approved"
                                                selected="@(Model.Status == ReservationStatus.Approved ? "selected" : "")">
                                            Approved
                                        </option>
                                        <option value="@ReservationStatus.Rejected"
                                                selected="@(Model.Status == ReservationStatus.Rejected ? "selected" : "")">
                                            Rejected
                                        </option>
                                    </select>

                                </div>
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </form>
                        </div> <!-- end card body-->
                    </div> <!-- end card -->
                </div><!-- end col-->
            </div> <!-- end row-->

            <div class="row">
                <div class="col-md-12">
                    <div class="project-info-box">
                        <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                    </div>
                </div>
            </div>

        </div> <!-- container -->
    </div> <!-- content -->
    <!-- Footer Start -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © Velonic - Theme by <b>Techzaa</b>
                </div>
            </div>
        </div>
    </footer>
    <!-- end Footer -->
</div>

