@model ProductEditVM

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Product Edit</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <form method="post" enctype="multipart/form-data">
                                <div class="form-group">
                                    <label for="Name">Name</label>
                                    <input asp-for="Name" class="form-control" id="Name" />
                                    <span class="text-danger" asp-validation-for="Name"></span>
                                </div>
                                <div class="form-group">
                                    <label for="Ingredient">Ingredient</label>
                                    <input asp-for="Ingredient" class="form-control" id="Ingredient" />
                                    <span class="text-danger" asp-validation-for="Ingredient"></span>
                                </div>
                                <div class="form-group">
                                    <label for="Price">Price</label>
                                    <input asp-for="Price" class="form-control" id="Price" type="number" step="0.01" />
                                    <span class="text-danger" asp-validation-for="Price"></span>
                                </div>
                                <div class="form-group">
                                    <label for="MenuCategoryId">Menu Category</label>
                                    <select asp-for="MenuCategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.MenuCategories, "Id", "Name", Model.MenuCategoryId))"></select>
                                    <span class="text-danger" asp-validation-for="MenuCategoryId"></span>
                                </div>

                                <div class="form-group">
                                    <label for="SpecialCategoryId">Special Category</label>
                                    <select asp-for="SpecialCategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.SpecialCategories, "Id", "Name", Model.SpecialCategoryId))"></select>
                                    <span class="text-danger" asp-validation-for="SpecialCategoryId"></span>
                                </div>

                                <div class="form-group">
                                    <label for="CuisineId">Cuisine</label>
                                    <select asp-for="ProductCuisineId" class="form-control" asp-items="@(new SelectList(ViewBag.Cuisines, "Id", "Name", Model.ProductCuisineId))"></select>
                                    <span class="text-danger" asp-validation-for="ProductCuisineId"></span>
                                </div>

                                <div class="form-group">
                                    <label for="Files">Images</label>
                                    <input type="file" asp-for="Files" class="form-control" id="Files" multiple />
                                    <span class="text-danger" asp-validation-for="Files"></span>
                                </div>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © Velonic - Theme by <b>Techzaa</b>
                </div>
            </div>
        </div>
    </footer>
</div>
