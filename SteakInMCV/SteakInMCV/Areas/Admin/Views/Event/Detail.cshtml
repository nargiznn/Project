@model EventVM

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <!-- Page Title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Event Data Detail</h4>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="event-details">
                                <p><strong>Id:</strong> @Model.Id</p>
                                <p><strong>Title:</strong> @Model.Title</p>
                                <p><strong>Description:</strong> @Model.Desc</p>
                                <p><strong>Info:</strong> @Model.Info</p>

                                <h5>Tags</h5>
                                <p>
                                    @if (Model.Tags != null && Model.Tags.Any())
                                    {
                                        <ul>
                                            @foreach (var tag in Model.Tags)
                                            {
                                                <li>@tag</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span>No tags</span>
                                    }
                                </p>

                                <h5>Comments & Replies</h5>
                                @if (Model.Comments != null && Model.Comments.Any())
                                {
                                    <ul>
                                        @foreach (var comment in Model.Comments)
                                        {
                                            <li>
                                                <strong>Comment:</strong> @comment.AuthorName - @comment.Content (@comment.Status)
                                                <ul>
                                                    @if (comment.Replies != null && comment.Replies.Any())
                                                    {
                                                        @foreach (var reply in comment.Replies)
                                                        {
                                                            <li>
                                                                <strong>Reply:</strong> @reply.AuthorName - @reply.Content (@reply.Status)
                                                            </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <li>No Replies</li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p>No Comments</p>
                                }

                                <h5>Image</h5>
                                <img src="@Model.ImgUrl" style="width:150px; height:100px; border-radius: 5px;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © Velonic - Theme by <b>Techzaa</b>
                </div>
            </div>
        </div>
    </footer>
</div> 