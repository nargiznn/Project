@model SteakInMCV.Areas.Admin.ViewModels.Position.PositionVM

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <!-- Page Title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Position Data Detail</h4>
                    </div>
                </div>
            </div>

            <!-- Faq Details -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="faq-details">
                                <p><strong>Id:</strong> @Model.Id</p>
                                <p><strong>Title:</strong> @Model.Title</p>\
                                <p><strong>Description:</strong> @Model.Description</p>
                                <p><strong>IsActive:</strong> @Model.IsActive</p>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Back Button -->
            <div class="row">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © SteakIn - Theme by <b>Admin</b>
                </div>
            </div>
        </div>
    </footer>
</div>
