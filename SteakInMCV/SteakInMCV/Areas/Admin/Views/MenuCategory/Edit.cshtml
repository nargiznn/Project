@model SteakInMCV.Areas.Admin.ViewModels.MenuCategory.MenuCategoryEditVM

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="#">SteakIn</a></li>
                                <li class="breadcrumb-item"><a href="#">MenuCategory</a></li>
                                <li class="breadcrumb-item active">Edit MenuCategory</li>
                            </ol>
                        </div>
                        <h4 class="page-title">Edit MenuCategory</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <form method="post" enctype="multipart/form-data" asp-controller="MenuCategory" asp-action="Edit">
                                <div class="form-group">
                                    <label for="Name">Name</label>
                                    <input asp-for="Name" class="form-control" id="Name">
                                    <span class="text-danger" asp-validation-for="Name"></span>
                                </div>

                                <div class="form-group">
                                    <label for="IsActive">Is Active</label>
                                    <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true"
                                           @(Model.IsActive == true ? "checked" : "") />
                                    <span class="text-danger" asp-validation-for="IsActive"></span>
                                </div>

                                <button type="submit" class="btn btn-primary">Update</button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © SteakIn - Theme by <b>Admin</b>
                </div>
            </div>
        </div>
    </footer>
</div>
