@model SteakInMCV.Areas.Admin.ViewModels.Testimonial.TestimonialCreateVM

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="#">SteakIn</a></li>
                                <li class="breadcrumb-item"><a href="#">Testimonial</a></li>
                                <li class="breadcrumb-item active">Create Testimonial</li>
                            </ol>
                        </div>
                        <h4 class="page-title">Create Testimonial</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div asp-validation-summary="All" class="text-danger"></div>

                            <form method="post" enctype="multipart/form-data" asp-controller="Testimonial" asp-action="Create">
                                <div class="form-group">
                                    <label for="Name">Name</label>
                                    <input asp-for="Name" class="form-control" id="Name" required />
                                    <span class="text-danger" asp-validation-for="Name"></span>
                                </div>

                                <div class="form-group">
                                    <label for="Surname">Surname</label>
                                    <input asp-for="Surname" class="form-control" id="Surname" required />
                                    <span class="text-danger" asp-validation-for="Surname"></span>
                                </div>

                                <div class="form-group">
                                    <label for="Text">Text</label>
                                    <textarea asp-for="Text" class="form-control" id="Text" required></textarea>
                                    <span class="text-danger" asp-validation-for="Text"></span>
                                </div>

                                <div class="form-group">
                                    <label for="Raiting">Raiting</label>
                                    <input asp-for="Raiting" type="number" min="1" max="5" class="form-control" id="Raiting" required />
                                    <span class="text-danger" asp-validation-for="Raiting"></span>
                                </div>

                                <div class="form-group">
                                    <label for="ReviewType">Review Type</label>
                                    <select asp-for="ReviewType" class="form-control" asp-items="Model.ReviewTypeList">
                                        <option value="">Seçin</option>
                                    </select>
                                    <span class="text-danger" asp-validation-for="ReviewType"></span>

                                </div>





                                <div class="form-group">
                                    <label for="file">File</label>
                                    <input type="file" asp-for="file" class="form-control" id="File" />
                                    <span class="text-danger" asp-validation-for="file"></span>
                                </div>


                                <button type="submit" class="btn btn-primary">Create</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-success mt-5">Back</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <script>document.write(new Date().getFullYear())</script> © SteakIn - Theme by <b>Admin</b>
                </div>
            </div>
        </div>
    </footer>
</div>
