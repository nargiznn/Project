@model ElementVM
        <!-- Page Title #1
        ============================================= -->
        <section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
            <div class="bg-section">
                <img src="@Model.Settings["ElementPricingBgg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="title title-1 text-center">
                            <div class="title--content">
                                <div class="title--subtitle">@Model.Settings["ElementSubtitle"]</div>
                                <div class="title--heading">
                                    <h1>@Model.Settings["ElementPricingHeading"]</h1>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <ol class="breadcrumb">
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Element" asp-action="Pricing">Elements</a></li>
                                <li class="active">Pricing Tables</li>
                            </ol>
                            <div class="divider--shape-1down"></div>
                        </div>
                        <!-- .title end -->
                    </div>
                    <!-- .col-md-12 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <!-- #page-title end -->

        <div class="cleafix mb-150"></div>

        <!-- Pricing #1
        ============================================= -->
        <section id="pricing" class="pricing text-center bg-white">
            <div class="container">
                <div class="row clearfix">
                    <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                        <div class="heading heading-1 mb-50 text--center">
                            <p class="heading--subtitle">@Model.Settings["OrderText"]</p>
                            <h2 class="heading--title">@Model.Settings["OurMenuTitle"]</h2>
                            <div class="divider--shape-4"></div>
                            <p class="heading--desc">@Model.Settings["OurMenuDesc"]</p>
                        </div>
                    </div>
                    <!-- .col-md-8 end -->
                </div>
                <!-- .row end -->
                <div class="row">
                    <!-- Pricing Packge #1
    ============================================= -->
                    @foreach (var item in Model.MealPackages)
                    {
                        <div class="col-md-4 col-sm-4 col-xs-12 price-table">
                            <div class="pricing-panel">
                                <!--  Pricing heading  -->
                                <div class="pricing--heading text--center">
                                    <p><span class="currency">$</span>@item.Price.ToString("0")<span class="time"> / @item.Title</span></p>
                                    <div class="pricing--desc">
                                        @item.Desc
                                    </div>
                                    <div class="divider--shape-1down divider--shape-white"></div>
                                </div>
                                <!--  Pricing body  -->
                                <div class="pricing--body text--center">
                                    <ul class="list-group">
                                        @foreach (var productName in item.ProductNames)
                                        {
                                        <li class="list-group-item text-capitalize">@productName</li> 
                                        }

                                    </ul>
                                </div>
                                <!--  .Pricing Body end -->
                                <!--  Packge Footer  -->
                                <div class="panel-footer">
                                    <a class="btn btn--primary btn--block" asp-controller="BookATable" asp-action="Index">Book a table </a>
                                </div>
                            </div>
                        </div>
                    }
                    <!-- Package End -->


                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <div class="cleafix mb-150"></div>

        <!-- Pricing #2
        ============================================= -->
        <section id="pricing2" class="pricing pricing-2 text-center bg-white">
            <div class="container">
                <div class="row mb-70">
                    <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                        <div class="heading text--center">
                            <p class="heading--subtitle">@Model.Settings["OrderText"]</p>
                            <h2 class="heading--title">@Model.Settings["LunchSetTitle"]</h2>
                            <div class="divider--shape"></div>
                            <p class="heading--desc"> @Model.Settings["LunchSetDesc"]</p>
                        </div>
                    </div>
                    <!-- .col-md-8 end -->
                </div>
                <!-- .row end -->
                <div class="row">

                    <!-- Pricing Packge #1
    ============================================= -->
                    @foreach (var item in Model.LunchSets)
                    {
                        <div class="col-md-4 col-sm-4 col-xs-12 price-table">
                            <div class="pricing-panel">
                                <!--  Pricing heading  -->
                                <div class="pricing--heading text--center">
                                    <p><span class="currency">$</span>@item.Price.ToString("0")<span class="time"> / @item.Title</span></p>
                                    <div class="pricing--desc">
                                       @item.Desc
                                    </div>
                                    <div class="divider--shape-1down divider--shape-white"></div>
                                </div>
                                <!--  Pricing body  -->
                                <div class="pricing--body text--center">
                                    <ul class="list-group">

                                        @foreach (var productName in item.ProductNames)
                                        {
                                            <li class="list-group-item text-capitalize">@productName</li>

                                        }
                                    </ul>
                                </div>
                                <!--  .Pricing Body end -->
                                <!--  Packge Footer  -->
                            </div>
                            <div class="panel-footer">
                                <a class="btn btn--primary btn--block" asp-controller="BookATable" asp-action="Index">Book a table </a>
                            </div>
                        </div>
                    }
                    <!-- Package End -->

                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>

        <div class="cleafix mb-150"></div>

