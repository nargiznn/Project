@model ElementVM
     <!-- Page Title #1
        ============================================= -->
        <section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
            <div class="bg-section">
                <img src="@Model.Settings["ElementCounterBg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="title title-1 text-center">
                            <div class="title--content">
                                <div class="title--subtitle">@Model.Settings["ElementSubtitle"]</div>
                                <div class="title--heading">
                                    <h1>@Model.Settings["ElementCounterHeading"]</h1>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <ol class="breadcrumb">
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Element" asp-action="Client">Elements</a></li>
                                <li class="active">Counters</li>
                            </ol>
                            <div class="divider--shape-1down"></div>
                        </div>
                        <!-- .title end -->
                    </div>
                    <!-- .col-md-12 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <!-- #page-title end -->

        <div class="clearfix pt-150 bg-gray"></div>

        <!-- Counter #2
        ============================================= -->
        <section id="counter2" class="counter counter-2 bg-overlay bg-parallax bg-overlay-dark">
            <div class="bg-section">
                <img src="@Model.Settings["CounterClientBgg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="divider--shape-1up"></div>
                <div class="row">
                    <!-- count #1 -->
                    @foreach (var statistic in Model.Statistics)
                    {
                        <div class="col-xs-6 col-sm-3 col-md-3">
                            <div class="count-box text-center">
                                <div class="counting">@statistic.Value</div>
                                <div class="count-title">@statistic.Key</div>
                            </div>
                        </div>
                    }
                    <!-- .col-md-3 end -->

                </div>
                <!-- .row end -->
                <div class="divider--shape-1down"></div>
            </div>
            <!-- .container end -->
        </section>
        <!-- #counter2 end -->

        <div class="clearfix pt-150 bg-gray"></div>


