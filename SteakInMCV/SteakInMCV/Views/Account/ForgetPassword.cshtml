@model ForgetPasswordVM

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Sign Up Form </title>

    <!-- Font Icon -->
    <link rel="stylesheet" href="~/account/fonts/material-icon/css/material-design-iconic-font.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <link href="~/assets/css/vendor/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <link href="~/account/css/icons.min.css" rel="stylesheet" type="text/css" />

    <link href="~/account/css/theme.min.css" rel="stylesheet" type="text/css" />


    <!-- Main css -->
    <link rel="stylesheet" href="~/account/css/style.css">
</head>
<body>

    <div class="main">

        <section class="signup">
            <!-- <img src="images/signup-bg.jpg" alt=""> -->
            <div class="container">
                <div class="signup-content">
                    <div class="p-5">
                        <div class="text-center mb-5">
                            <a href="/Shop/Index/" class="text-dark font-size-22 font-family-secondary" style="text-decoration:none;width:370px">
                                <i class=""></i> <b>
                                    Norda Store Forgot Password Page
                                </b>
                            </a>
                        </div>
                        <h1 class="h5 mb-1">Forgot Your Password?</h1>
                        <p class="text-muted mb-4">Enter your email address to reset your password.</p>
                        <form asp-action="ForgetPassword" method="post">
                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" class="form-control" id="email" name="email" asp-for="email" autocomplete="off" required />
                                <span class="text-danger" asp-validation-for="email" style="text-align:left;display:block;"></span>

                            </div>
                            <button type="submit" class="btn btn-success">Submit</button>
                        </form>

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <p class="text-muted mb-0">Back to <a asp-controller="Account" asp-action="Login" class="text-muted font-weight-medium ml-1"><b>Login</b></a></p>
                            </div> <!-- end col -->
                        </div>
                        <!-- end row -->
                    </div> <!-- end .padding-5 -->
                </div>
            </div>
        </section>

    </div>



    <!-- JS -->
    <script src="~/acount/vendor/jquery/jquery.min.js"></script>
    <script src="!/account/js/main.js"></script>
</body><!-- This templates was made by Colorlib (https://colorlib.com) -->
</html>