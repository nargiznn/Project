

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Reset Password Confirmation - Norda Store</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="MyraStudio" name="author" />
    <meta http-equiv="" content="IE=edge" />
    <link rel="shortcut icon" href="~/account/vertical/assets/images/favicon.ico">
    <link href="~/account/vertical/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/account/vertical/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/account/vertical/assets/css/theme.min.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="main">

        <section class="signup">
            <!-- <img src="images/signup-bg.jpg" alt=""> -->
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex align-items-center min-vh-100">
                            <div class="w-100 d-block bg-white shadow-lg rounded my-5">
                                <div class="row">
                                    <div class="col-lg-5 ">
                                        <img src="~/account/vertical/assets/images/ContactUs-2024.jpg" style="width:100%;height:100%;" alt="IMG">

                                    </div>
                                    <div class="col-lg-7">
                                        <div class="p-5">
                                            <div class="text-center mb-5">
                                                <a href="/Shop/Index/" class="text-dark font-size-22 font-family-secondary">
                                                    <i class=""></i> <b>
                                                        Norda Store Password Reset Confirmation
                                                    </b>
                                                </a>
                                            </div>
                                            <h1 class="h5 mb-1">Password Reset Request Sent</h1>
                                            <p class="text-muted mb-4"> Success.</p>

                                            <div class="row mt-4">
                                                <div class="col-12 text-center">
                                                    <p class="text-muted mb-0">Back to <a asp-controller="Account" asp-action="Login" class="text-muted font-weight-medium ml-1"><b>Login</b></a></p>
                                                </div> <!-- end col -->
                                            </div>
                                            <!-- end row -->
                                        </div> <!-- end .padding-5 -->
                                    </div> <!-- end col -->
                                </div> <!-- end row -->
                            </div> <!-- end .w-100 -->
                        </div> <!-- end .d-flex -->
                    </div> <!-- end col-->
                </div> <!-- end row -->
            </div>
            <!-- end container -->
        </section>

    </div>

    <script>const registerPasswordIcons = document.querySelectorAll(".register-password-eye");

        registerPasswordIcons.forEach(icon => {
            icon.addEventListener("click", function () {
                if (this.previousElementSibling.previousElementSibling.getAttribute("type") == "password") {
                    this.previousElementSibling.previousElementSibling.setAttribute("type", "text");
                    this.classList.remove("fa-eye");
                    this.classList.add("fa-eye-slash");
                } else {
                    this.previousElementSibling.previousElementSibling.setAttribute("type", "password");
                    this.classList.add("fa-eye");
                    this.classList.remove("fa-eye-slash");

                }
            });
        });</script>
    <script src="~/account/vertical/assets/js/jquery.min.js"></script>
    <script src="~/account/vertical/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/account/vertical/assets/js/metismenu.min.js"></script>
    <script src="~/account/vertical/assets/js/waves.js"></script>
    <script src="~/account/vertical/assets/js/simplebar.min.js"></script>
    <script src="~/account/vertical/assets/js/theme.js"></script>
</body>
</html>