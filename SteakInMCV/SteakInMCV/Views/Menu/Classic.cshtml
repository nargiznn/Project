<!-- Page Title #1
============================================= -->
<section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
    <div class="bg-section">
        <img src="~/assets/images/page-title/@Model.Settings["SimplePageBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="title title-1 text-center">
                    <div class="title--content">
                        <div class="title--subtitle">@Model.Settings["SimplePageTitle"]</div>
                        <div class="title--heading">
                            <h1>@Model.Settings["SimplePageMain"]</h1>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <ol class="breadcrumb">
                        <li>
                            <a href="index.html">Home</a>
                        </li>
                        <li>
                            <a href="index.html">menu</a>
                        </li>
                        <li class="active">classic</li>
                    </ol>
                    <div class="divider--shape-1down"></div>
                </div>
                <!-- .title end -->
            </div>
            <!-- .col-md-12 end -->
        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #page-title end -->
<!-- Heading #1
============================================= -->
<section id="heading1" class="heading heading-1">
    <div class="container">
        <div class="row clearfix">
            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                <div class="text--center">
                    <p class="heading--subtitle">@Model.Settings["MenuSectionSubtitle"]</p>
                    <h2 class="heading--title mb-0">@Model.Settings["MenuSectionTitle"]</h2>
                    <div class="divider--shape-4"></div>
                    <p class="heading--desc"> @Model.Settings["MenuSectionDescription"]</p>
                </div>
            </div>
            <!-- .col-md-8 end -->
        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #heading1 end -->
<!-- Divider #1
============================================= -->
<section id="divider1" class="section-divider3 bg-overlay bg-parallax bg-overlay-dark4">
    <div class="bg-section">
        <img src="~/assets/images/background/@Model.Settings["BreakfastStartMenuBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="divider--shape-1up"></div>
        <div class="row clearfix">
            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                <div class="heading heading-3 text--center">
                    <p class="heading--subtitle">@Model.Settings["BreakfastStartTime"]</p>
                    <h2 class="heading--title mb-0 text-white">@Model.Settings["BreakfastMenuTitle"]</h2>
                </div>
            </div>
            <!-- .col-md-8 end -->
        </div>
        <!-- .row end -->
        <div class="divider--shape-4down"></div>
    </div>
    <!-- .container end -->
</section>
<!-- #divider1 end -->
<!-- Menu #classic
============================================= -->
@model MenuVM
<!-- Menü Kategorisi: Breakfast -->
<section id="menu1" class="menu menu-classic">
    <div class="container">
        <div class="row">
            @foreach (var category in Model.MenuCategories.Where(c => c.Name.Equals("Breakfast", StringComparison.OrdinalIgnoreCase)))
            {
                @foreach (var product in category.Products)
                {
                    <div class="col-xs-12 col-sm-12 col-md-4">
                        <div class="dish-panel">
                            <h3 class="dish--title">@product.Name</h3>
                            <div class="dish--price">@product.Price.ToString("C")</div>
                            <p class="dish--desc">@product.Ingredient</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- #menu1 end -->
