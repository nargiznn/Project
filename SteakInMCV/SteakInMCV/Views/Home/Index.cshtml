@model HomeVM
<!-- Hero Section
====================================== -->
<section id="slider" class="slider slide-overlay-dark">
    <div class="rev_slider_wrapper">
        <div id="slider1" class="rev_slider" data-version="5.0">
            <ul>
                @foreach (var item in Model.Sliders)
                {
                    <li data-transition="zoomin"
                        data-slotamount="default"
                        data-easein="Power4.easeInOut"
                        data-easeout="Power4.easeInOut"
                        data-masterspeed="2000">
                        <!-- MAIN IMAGE -->
                        <img src="~/assets/images/sliders/slide-bg/@item.Image" alt="Slide Background Image" width="1920" height="1280">

                        <!-- LAYER NR. 1 -->
                        <div class="tp-caption"
                             data-x="center" data-hoffset="0"
                             data-y="center" data-voffset="-130"
                             data-whitespace="nowrap"
                             data-width="none"
                             data-height="none"
                             data-frames='[{"delay":1500,"speed":1000,"frame":"0","from":"y:-50px;opacity:0;","to":"o:1;","ease":"Power3.easeInOut"},{"delay":"wait","speed":300,"frame":"999","to":"auto:auto;","ease":"Power3.easeInOut"}]'
                             data-splitin="none"
                             data-splitout="none"
                             data-responsive_offset="on">
                            <div class="slide--subheadline">@item.Title</div>
                        </div>

                        <!-- LAYER NR. 2 -->
                        <div class="tp-caption"
                             data-x="center" data-hoffset="0"
                             data-y="center" data-voffset="-65"
                             data-whitespace="nowrap"
                             data-width="none"
                             data-height="none"
                             data-frames='[{"delay":1750,"speed":1000,"frame":"0","from":"x:-50px;opacity:0;","to":"o:1;","ease":"Power3.easeInOut"},{"delay":"wait","speed":300,"frame":"999","to":"auto:auto;","ease":"Power3.easeInOut"}]'
                             data-splitin="none"
                             data-splitout="none"
                             data-responsive_offset="on">
                            <div class="slide--headline">@item.MainTitle</div>
                        </div>

                        <!-- LAYER NR. 3 -->
                        <div class="tp-caption"
                             data-x="center" data-hoffset="0"
                             data-y="center" data-voffset="20"
                             data-width="none"
                             data-height="none"
                             data-frames='[{"delay":2000,"speed":1000,"frame":"0","from":"y:50px;opacity:0;","to":"o:1;","ease":"Power3.easeInOut"},{"delay":"wait","speed":300,"frame":"999","to":"opacity:0;","ease":"Power3.easeInOut"}]'
                             data-splitin="none"
                             data-splitout="none"
                             data-responsive_offset="on">
                            <div class="slide--bio text--center">@item.Desc</div>
                        </div>

                        <!-- LAYER NR. 4 -->
                        <div class="tp-caption"
                             data-x="center" data-hoffset="0"
                             data-y="center" data-voffset="100"
                             data-width="none"
                             data-height="none"
                             data-whitespace="nowrap"
                             data-frames='[{"delay":2000,"speed":1500,"frame":"0","from":"y:bottom;rX:-20deg;rY:-20deg;rZ:0deg;","to":"o:1;","ease":"Power3.easeOut"},{"delay":"wait","speed":300,"frame":"999","to":"auto:auto;","ease":"Power3.easeInOut"}]' data-basealign="slide"
                             data-responsive_offset="on"
                             data-responsive="off">
                            <div class="slide-action">
                                <a class="btn btn--white btn--bordered btn--rounded btn--lg" asp-controller="@item.BtnText" asp-action="Index">@item.BtnText</a>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

<!-- banner#4
============================================= -->
<section id="banner4" class="banner banner-2 text-center">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6">
                <div class="heading heading-1 text--center">
                    <p class="heading--subtitle">@Model.Settings["WelcomeTitle"]</p>
                    <h2 class="heading--title">@Model.Settings["WelcomeInfo"]</h2>
                    <div class="divider--shape-4"></div>
                    <p class="heading--desc">@Model.Settings["WelcomeDesc"]</p>
                </div>
                <!-- .heading end -->
                <a class="btn btn--secondary btn--bordered btn--rounded mt-30" asp-controller="BookATable" asp-action="Index">@Model.Settings["WelcomeBtnText"]</a>
            </div>
            <!-- .col-md-6 end -->
            <div class="col-xs-12 col-sm-6 col-md-3">
                <div class="banner-img mt-20">
                    <img src="~/assets/images/banners/@Model.Settings["WelcomeImgLeft"]" alt="image">
                </div>
            </div>
            <!-- .col-md-3 end -->
            <div class="col-xs-12 col-sm-6 col-md-3">
                <div class="banner-img">
                    <img src="~/assets/images/banners/@Model.Settings["WelcomeImgRight"]" alt="image">
                </div>
                <!-- .col-md-3 end -->
            </div>
            <!-- .col-md-3 end -->
        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #banner4 end -->
<!-- specials #1
============================================= -->
<section id="specials1" class="specials specials-1 menu-simple bg-overlay bg-parallax bg-overlay-dark">
    <div class="bg-section">
        <img src="~/assets/images/background/@Model.Settings["HomeSpecialBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="divider--shape-1up"></div>
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-10 col-md-offset-1">
                <div class="dishes-wrapper">
                    <div class="dishes-bordered">
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                                <div class="heading heading-1 mb-50 text--center">
                                    <p class="heading--subtitle">@Model.Settings["Delicious"]</p>
                                    <h2 class="heading--title">@Model.Settings["Special"]</h2>
                                    <div class="divider--shape-4"></div>
                                </div>
                            </div>
                            <!-- .col-md-8 end -->
                        </div>
                        <!-- .row end -->
                        <div class="row">
                            <!-- Dish #1 -->
                            @if (Model.Products.Any(p => !string.IsNullOrEmpty(p.SpecialCategoryName)))
                            {
                                @foreach (var item in Model.Products.Where(p => !string.IsNullOrEmpty(p.SpecialCategoryName)).TakeLast(4))
                                {
                                    <div class="col-xs-12 col-sm-12 col-md-6">
                                        <div class="dish-panel">
                                            <div class="dish--img">
                                                <img src="~/assets/images/menu/dish/@item.ImageUrls.FirstOrDefault()" alt="dish">
                                            </div>
                                            <div class="dish--content">
                                                <div class="dish--content-bio">
                                                    <h3 class="dish--title">@item.Name</h3>
                                                    <div class="dish--price">$@item.Price.ToString("F2")</div>
                                                </div>
                                                <p class="dish--desc">@item.Ingredient</p>
                                            </div>
                                        </div>
                                        <!-- .dish end -->
                                    </div>
                                }
                                <!-- .dish-panel end -->
                            }

                        </div>
                        <!-- .row end -->
                    </div>
                    <!-- .dishes-bordered end -->
                </div>
                <!-- .dishes-wrapper end -->
            </div>
            <!-- .col-md-10 end -->
        </div>
        <!-- .row end -->
        <div class="divider--shape-1down"></div>
    </div>
    <!-- .container end -->
</section>
<!-- #specials1 end -->
<!-- Menu Board
============================================= -->
<section id="menuBoard" class="pb-90">
    <div class="container">
        <div class="row clearfix">
            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                <div class="heading heading-1 mb-50 text--center">
                    <p class="heading--subtitle">@Model.Settings["MealsTitle"]</p>
                    <h2 class="heading--title mb-0">@Model.Settings["MealsMain"]</h2>
                    <div class="divider--shape-4"></div>
                    <p class="heading--desc">@Model.Settings["MealsDesc"]</p>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid tabs">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs">
                    @foreach (var category in Model.MenuCategories)
                    {
                        <li class="@(category.IsActive ? "active" : "")">
                            <a href="#@category.Name.ToLower()" data-toggle="tab">@category.Name</a>
                        </li>
                    }
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    @foreach (var category in Model.MenuCategories)
                    {
                        <div class="tab-pane fade @(category.IsActive ? "active in" : "")" id="@category.Name.ToLower()">
                            <div class="menu menu-board text-center">
                                <div class="row">
                                    <div class="dishes-wrapper">
                                        @foreach (var product in category.Products
                                           .Where(p => p.SpecialCategoryName == "Chef Selection")
                                           .Take(1))
                                        {
                                            <div class="col-xs-12 col-sm-12 col-md-6">
                                                <div class="row dish-panel">
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--content">
                                                            <div class="dish--tag">@product.SpecialCategoryName</div>
                                                            <span class="dish--price">$@product.Price.ToString("F2")</span>
                                                            <h3 class="dish--title">@product.Name</h3>
                                                            <div class="divider--shape-4"></div>
                                                            <p class="dish--desc">@product.Ingredient</p>
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--img">
                                                            <div class="divider--shape-left"></div>
                                                            <img src="~/assets/images/menu/dish/@product.ImageUrls.FirstOrDefault()" alt="@product.Name">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @foreach (var product in category.Products
                                           .Where(p => string.IsNullOrEmpty(p.SpecialCategoryName))
                                           .Take(1))
                                        {
                                            <div class="col-xs-12 col-sm-12 col-md-6">
                                                <div class="row dish-panel">
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--content">
                                                            <span class="dish--price">$@product.Price.ToString("F2")</span>
                                                            <h3 class="dish--title">@product.Name</h3>
                                                            <div class="divider--shape-4"></div>
                                                            <p class="dish--desc">@product.Ingredient</p>
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--img">
                                                            <img src="~/assets/images/menu/dish/@product.ImageUrls.FirstOrDefault()" alt="@product.Name">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @foreach (var product in category.Products
                                           .Where(p => p.SpecialCategoryName == "New")
                                           .Take(1))
                                        {
                                            <!-- New -->
                                            <div class="col-xs-12 col-sm-12 col-md-6">
                                                <div class="row dish-panel">
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--img">
                                                            <img src="~/assets/images/menu/dish/@product.ImageUrls.FirstOrDefault()" alt="@product.Name">
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--content">
                                                            <div class="dish--tag">@product.SpecialCategoryName</div>
                                                            <span class="dish--price">$@product.Price.ToString("F2")</span>
                                                            <h3 class="dish--title">@product.Name</h3>
                                                            <div class="divider--shape-4"></div>
                                                            <p class="dish--desc">@product.Ingredient</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @foreach (var product in category.Products
                                           .Where(p => string.IsNullOrEmpty(p.SpecialCategoryName))
                                           .Take(1))
                                        {
                                            <div class="col-xs-12 col-sm-12 col-md-6">
                                                <div class="row dish-panel">
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--img">
                                                            <img src="~/assets/images/menu/dish/@product.ImageUrls.FirstOrDefault()" alt="@product.Name">
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                                        <div class="dish--content">
                                                            <span class="dish--price">$@product.Price.ToString("F2")</span>
                                                            <h3 class="dish--title">@product.Name</h3>
                                                            <div class="divider--shape-4"></div>
                                                            <p class="dish--desc">@product.Ingredient</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>


            </div>
        </div>
    </div>


    <div class="container">
        <div class="row clearfix">
            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2 text--center">
                <a class="btn btn--primary btn--bordered btn--rounded btn--lg mt-50" asp-controller="Menu" asp-action="Classic">@Model.Settings["MealsBtnText"]</a>
            </div>
        </div>
    </div>
</section>




<!-- #menuBoard end -->
<!-- Testimonial #1
============================================= -->
<section id="testimonial1" class="testimonial testimonial-1 bg-overlay bg-parallax bg-overlay-dark pb-90">
    <div class="bg-section">
        <img src="~/assets/images/background/@Model.Settings["TestimonialHomePageBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="divider--shape-1up"></div>
        <div class="row clearfix">
            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                <div class="heading heading-1 mb-50 text--center">
                    <p class="heading--subtitle">@Model.Settings["Testimonials"]</p>
                    <h2 class="heading--title color-white">@Model.Settings["Customer"]</h2>
                    <div class="divider--shape-13"></div>
                </div>
            </div>
            <!-- .col-md-8 end -->
        </div>
        <!-- .row end -->
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="testimonial-carousel" class="carousel carousel-dots carousel-white" data-slide="3" data-slide-rs="1" data-autoplay="false" data-nav="false" data-dots="true" data-space="30" data-loop="true" data-speed="800">
                    <!-- Testimonial #1 -->

                    @foreach (var customer in Model.Testimonials.Where(c => c.ReviewType.HasValue && c.ReviewType.Value == Models.ReviewType.Chef && c.IsPermit).TakeLast(4))
                    {
                        <div class="testimonial-container">

                            <div class="testimonial-panel">
                                <div class="testimonial-bordered">
                                    <div class="testimonial--rating">
                                        @for (int i = 1; i <= customer.Raiting; i++)
                                        {
                                            <i class="fa fa-star"></i>
                                        }
                                        @for (int i = customer.Raiting + 1; i <= 5; i++)
                                        {
                                            <i class="fa fa-star-o"></i>
                                        }
                                    </div>
                                    <!-- .testimonial-rating end -->
                                    <div class="testimonial--body">
                                        <p>“@customer.Text”</p>
                                    </div>
                                    <!-- .testimonial-body end -->
                                    <div class="testimonial--meta">
                                        <div class="testimonial--img">
                                            <img src="~/assets/images/testimonial/@customer.Image" alt="Testimonial Author">
                                        </div>
                                        <div class="testimonial--author">
                                            <h4>@customer.SurName @customer.Name</h4>
                                        </div>
                                    </div>
                                    <!-- .testimonial-meta end -->
                                </div>
                            </div>
                            <!-- .testimonial-panel end -->
                            <div class="divider--shape-1up"></div>
                        </div>

                    }

                </div>
            </div>
            <!-- .col-md-12 end -->
        </div>
        <!-- .row end -->
        <div class="divider--shape-1down"></div>
    </div>
    <!-- .container end -->
</section>
<!-- #testimonial1 end -->
<!-- Blog Carousel
============================================= -->
<section id="blog" class="blog blog-carousel pb-100 pb-100">
    <div class="container">
        <div class="row clearfix">
            <div class="col-xs-12 col-sm-12 col-md-8 col-md-offset-2">
                <div class="heading heading-1 mb-50 text--center">
                    <p class="heading--subtitle">@Model.Settings["EventTitle"]</p>
                    <h2 class="heading--title mb-0">@Model.Settings["EventMain"]</h2>
                    <div class="divider--shape-4"></div>
                </div>
            </div>
            <!-- .col-md-8 end -->
        </div>
        <!-- .row end -->
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="carousel" data-slide="3" data-slide-rs="2" data-autoplay="true" data-nav="false" data-dots="false" data-space="0" data-loop="true" data-speed="800">

                    @if (Model.EventVMs != null && Model.EventVMs.Any())
                    {
                        @foreach (var item in Model.EventVMs.Take(5))
                        {
                            <div class="blog-entry">

                                <div class="entry--content">
                                    <div class="entry--meta">
                                        <span class="entry--date">@item.CreatedDate.ToString("MMM dd, yyyy")</span>
                                        /@if (item.TagsName != null && item.TagsName.Any())
                                        {
                                            <span>
                                                @foreach (var tag in item.TagsName)
                                                {
                                                    <span> <a href="#">@tag</a></span>
                                                    @if (tag != item.TagsName.Last())
                                                    {
                                                        <span>,</span>
                                                    }
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                    </div>
                                    <div class="entry--title">
                                        <h4><a href="#">@item.Title</a></h4>
                                    </div>
                                    <div class="entry--img">
                                        <a href="#">
                                            <img src="~/assets/images/blog/grid/@item.ImgUrl" alt="entry image" />
                                        </a>
                                    </div>
                                    <div class="entry--bio">
                                        @item.Desc
                                    </div>
                                </div>
                                <!-- .entry-content end -->
                            </div>
                        }

                    }

                    <!-- Blog Entry #1 -->
                    <!-- .blog-entry end -->


                </div>
                <!-- .carousel end -->
            </div>
            <!-- .col-md-6 end -->
        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #blog end -->
