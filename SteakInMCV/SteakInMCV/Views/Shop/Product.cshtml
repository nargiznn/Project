@model ShopVM

        <!-- Page Title #1
        ============================================= -->
        <section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
            <div class="bg-section">
                <img src="~/assets/images/page-title/@Model.Settings["ShopBg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="title title-1 text-center">
                            <div class="title--content">
                                <div class="title--subtitle">@Model.Settings["ShopSubtitle"]</div>
                                <div class="title--heading">
                                    <h1>@Model.Settings["ShopHeading"]</h1>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <ol class="breadcrumb">
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Shop" asp-action="Product">shop</a></li>
                                <li class="active">Shop Products</li>
                            </ol>
                            <div class="divider--shape-1down"></div>
                        </div>
                        <!-- .title end -->
                    </div>
                    <!-- .col-md-12 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <!-- #page-title end -->
        <!-- Shop #4
        ===
        === === === === === === === === === === === === === === -->
        <section id="shop" class="shop shop-3 bg-white">
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-9">
                        <div class="row">
                            <div class="col-xs-12 col-sm-12  col-md-12">

                                <!-- .shop-options end -->
                            </div>
                            <!-- .col-md-12 end -->
                        </div>
                        <!-- .row end -->
                        <div class="row">
                            <!-- Product #1 -->
                            @foreach (var item in Model.Products)
                            {
                                <div class="col-xs-12 col-sm-6 col-md-4">
                                    <div class="product-item">
                                        <div style="width: 262px; height: 292px;" class="product--img">
                                            @{
                                                var firstImage = item.ImageUrls?.FirstOrDefault() ?? "default.jpg";
                                            }
                                            <img src="~/assets/images/shop/grid/@firstImage" alt="@item.Name" />
                                            <div class="product--hover">
                                                <div class="product--action">
                                                    <a href="#">Add To Cart</a>
                                                </div>
                                            </div>
                                            <!-- .product-overlay end -->
                                        </div>
                                        <!-- .product-img end -->
                                        <div class="product--content">
                                            <div class="product--title">
                                                <h3><a href="#">@item.Name</a></h3>
                                            </div>
                                            <!-- .product-title end -->
                                            <div class="product--price">
                                                <span>$@item.Price</span>
                                            </div>
                                            <!-- .product-price end -->
                                        </div>
                                        <!-- .product-bio end -->
                                    </div>
                                </div>
                            }
                            <!-- .productFilter end -->
                            <!-- Product #2 -->

                        </div>
                        <!-- .row end -->
                        <!-- .row end -->
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12 clearfix">
                                <ul class="pagination">
                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        if (ViewBag.PageIndex == i)
                                        {
                                            <li class="active"><a href="#">@i</a></li>
                                        }
                                        else
                                        {
                                            <li><a asp-route-page="@i">@i</a></li>
                                        }
                                    }

                                    @if (ViewBag.PageIndex < ViewBag.TotalPages)
                                    {
                                        <li>
                                            <a asp-route-page="@(ViewBag.PageIndex + 1)" aria-label="Next">
                                                <span aria-hidden="true"><i class="fa fa-long-arrow-right"></i></span>
                                            </a>
                                        </li>
                                    }


                                </ul>
                            </div>
                        </div>
                        <!-- .row end -->
                    </div>
                    <!-- .col-md-9 end -->
                    <div class="col-xs-12 col-sm-12 col-md-3">
                        <!-- Search
                        ============================================= -->
                        <div class="widget widget-search">
                            <div class="widget--content">
                                <form class="form-search">
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="Type Your Search Words">
                                        <span class="input-group-btn">
                                            <button class="btn" type="button"><i class="fa fa-search"></i></button>
                                        </span>

                                    </div>
                                    <!-- /input-group -->
                                </form>
                            </div>
                        </div> <!-- .widget-search end -->
                        <!-- Recent Products
                        ============================================= -->
                        <div class="widget widget-recent-products">
                            <div class="widget--title">
                                <h5>Best Sellers</h5>
                            </div>
                            <div class="widget--content">
                                <!-- Product #1 -->
                                @foreach (var item in Model.Products.OrderByDescending(p => p.SalesCount).Take(2))
                                {
                                    <div class="product clearfix">
                                        @{
                                            var firstImage = item.ImageUrls?.FirstOrDefault() ?? "default.jpg";
                                        }
                                        <img src="~/assets/images/shop/thumb/@firstImage" alt="@item.Name" />
                                        <div class="product-desc">
                                            <div class="product-title">
                                                <a href="#">@item.Name</a>
                                            </div>
                                            <div class="product-meta">
                                                <span>$@item.Price</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <!-- .recent-product end -->
                                <!-- Product #2 -->

                            </div>

                        </div> <!-- .widget-recent end -->
                        <!-- Filter
                        ============================================= -->
                        <div class="widget widget-filter">
                            <div class="widget--title">
                                <h5>Pricing Filter</h5>
                            </div>
                            <div class="widget--content">
                                <div id="slider-range"></div>
                                <p>
                                    <label for="amount">Price: </label>
                                    <input type="text" id="amount" readonly>
                                </p>
                                <a class="btn btn--secondary btn--bordered btn--rounded" href="#">Filter Now</a>
                            </div>
                        </div><!-- .widget-filter end -->
                        <!-- Instagram Feed
                        ============================================= -->
                        <!--<div class="widget widget-instagram">
                            <div class="widget--title">
                                <h5>Instagram</h5>
                            </div>
                            <div class="widget--content">
                                <div id="instafeedSidebar" class="instafeed" data-insta-number="8"></div>
                                <div class="clearfix"></div>
                            </div>
                        </div>--> <!-- .widget-instagram end -->
                        <!-- Tag Clouds
                        ============================================= -->
                        <div class="widget widget-tags">
                            <div class="widget--title">
                                <h5>Food Category</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var item in Model.FoodCategories)
                                {
                                    <a href="#">@item.Name</a>
                                }

                            </div>
                        </div> <!-- .widget-tags end -->
                    </div>
                    <!-- .col-md-3 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <!-- #shop end -->

