@model AboutVM
<!-- Page Title #1
============================================= -->
<section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
    <div class="bg-section">
        <img src="~/assets/images/page-title/@Model.Settings["ContactPageBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="title title-1 text-center">
                    <div class="title--content">
                        <div class="title--subtitle">@Model.Settings["ContactPageTitle"]</div>
                        <div class="title--heading">
                            <h1>@Model.Settings["ContactPageMain"]</h1>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <ol class="breadcrumb">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="About" asp-action="Contact">about</a></li>
                        <li class="active">contact</li>
                    </ol>
                    <div class="divider--shape-1down"></div>
                </div>
                <!-- .title end -->
            </div>
            <!-- .col-md-12 end -->
        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #page-title end -->
<!-- Contact #1
============================================= -->
<section id="contact1" class="contact contact-1">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="form-container">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-6">
                            <div class="contact--desc">
                                <p>@Model.Settings["WelcomeDesc"]</p>
                            </div>
                            <div class="row mb-30">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="contact--info">
                                        <h3>Our Address</h3>
                                        <p>@Model.Settings["Adress"]</p>
                                        <a class="link--styled" href="#">Get Directions</a>
                                    </div>
                                </div>
                                <!-- .col-md-6 end -->
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="contact--info">
                                        <h3>Our Phone</h3>
                                        <p>Office Telephone : @Model.Settings["Number"]</p>
                                        <p>Mobile : @Model.Settings["Mobile"]</p>
                                        <a class="link--styled" href="#">Call Us</a>
                                    </div>
                                </div>
                                <!-- .col-md-6 end -->
                            </div>
                            <!-- .row end -->
                            <div class="row">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="contact--info">
                                        <h3>Our Email</h3>
                                        <p>Main Email : @Model.Settings["Email"]</p>
                                        <p>Inquiries : @Model.Settings["Inquiries"]</p>
                                        <a class="link--styled" href="#">Send a Message</a>
                                    </div>
                                </div>
                                <!-- .col-md-6 end -->
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="contact--info">
                                        <h3>Follow Us</h3>
                                        <div class="social-icons">
                                            <a href="https://www.@Model.Settings["FacebookUrl"]" target="_blank"><i class="fa fa-facebook"></i></a>
                                            <a href="https://www.@Model.Settings["TwitterUrl"]" target="_blank"><i class="fa fa-twitter"></i></a>
                                            <a href="https://www.@Model.Settings["InstagramUrl"]" target="_blank"><i class="fa fa-instagram"></i></a>
                                            <a href="https://www.@Model.Settings["PinterestUrl"]" target="_blank"><i class="fa fa-pinterest"></i></a>
                                        </div>
                                    </div>
                                </div>
                                <!-- .col-md-6 end -->
                            </div>
                            <!-- .row end -->
                        </div>
                        <!-- .col-md-3 end -->

                        <form asp-action="Contact" asp-controller="About" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control" asp-for="ContactFormModel.FirstName" placeholder="First Name:" required />
                                    <span asp-validation-for="ContactFormModel.FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="form-control" asp-for="ContactFormModel.LastName" placeholder="Last Name:" required />
                                    <span asp-validation-for="ContactFormModel.LastName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="form-control" asp-for="ContactFormModel.Email" placeholder="Email:" required />
                                    <span asp-validation-for="ContactFormModel.Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="form-control" asp-for="ContactFormModel.Phone" placeholder="Phone:" required />
                                    <span asp-validation-for="ContactFormModel.Phone" class="text-danger"></span>
                                </div>
                                <div class="col-md-12">
                                    <textarea class="form-control" asp-for="ContactFormModel.Message" rows="4" placeholder="Message:" required></textarea>
                                    <span asp-validation-for="ContactFormModel.Message" class="text-danger"></span>
                                </div>
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-secondary mt-3">Send Message</button>
                                </div>
                            </div>
                        </form>

                        <!-- .col-md-6 end -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- #contact1 end -->
<!-- Google maps
============================================= -->
<section class="google-maps pb-0 pt-0">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 pr-0 pl-0">
                <div id="googleMap" style="width:100%; height:100vh;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3039.4286748536924!2d49.851370575914906!3d40.37719087144588!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40307d079efb5163%3A0xc20aa51a5f0b5e01!2sCode%20Academy!5e0!3m2!1str!2saz!4v1737018039040!5m2!1str!2saz"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>


