@model BookATableVM
<!-- Page Title #1 -->
<section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
    <div class="bg-section">
        <img src="@Model.Settings["BookATableBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="title title-1 text-center">
                    <div class="title--content">
                        <div class="title--subtitle">@Model.Settings["BookATableSubtitle"]</div>
                        <div class="title--heading">
                            <h1>@Model.Settings["BookATableHeading"]</h1>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <ol class="breadcrumb">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="active">Book A Table</li>
                    </ol>
                    <div class="divider--shape-1down"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Reservation Section -->
<section id="reservation" class="reservation bg-white pb-80 pt-90">
    <div class="container">
        <div class="text-center mb-4">
            <p>@Model.Settings["ReservationDec"]</p>
        </div>
        <form method="post">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-6">
                    <input type="text" class="form-control" asp-for="FirstName" placeholder="Name" required />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6">
                    <input type="text" class="form-control" asp-for="LastName" placeholder="Surname" required />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6">
                    <input type="email" class="form-control" asp-for="Email" placeholder="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6">
                    <input type="tel" class="form-control" asp-for="Phone" placeholder="Phone" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-4">
                    <div class="form-select">
                        <i class="fa fa-angle-down"></i>
                        <select class="form-control" asp-for="Capacity" id="peopleCountSelect" required>
                            <option value="">Select number of people</option>
                        </select>
                    </div>
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-4">
                    <div class="form-select">
                        <i class="fa fa-angle-down"></i>
                        <select class="form-control" asp-for="Date" id="datePicker" required>
                            <option value="">Select date</option>
                        </select>
                    </div>
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-4">
                    <div class="form-select">
                        <i class="fa fa-angle-down"></i>
                        <select class="form-control" asp-for="Time" id="timePicker" required>
                            <option value="">Select time</option>
                        </select>
                    </div>
                    <span asp-validation-for="Time" class="text-danger"></span>
                </div>


                <div class="col-xs-12 col-sm-12 col-md-12 mt-3">
                    <button type="submit" id="submit-message" class="btn btn--secondary btn--block">Create Reservation</button>
                </div>
            </div>
        </form>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        const peopleSelect = document.getElementById('peopleCountSelect');
        peopleSelect.innerHTML = '<option value="">Select number of people</option>';
        const maxPeople = 10;
        for (let i = 2; i <= maxPeople; i += 2) {
            const option = document.createElement('option');
            option.value = i;
            option.textContent = `${i} People`;
            peopleSelect.appendChild(option);
        }
        const dateSelect = document.getElementById('datePicker');
        dateSelect.innerHTML = '<option value="">Select date</option>';
        const today = new Date();
        for (let i = 0; i < 7; i++) {
            const newDate = new Date(today);
            newDate.setDate(today.getDate() + i);
            const dateString = newDate.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' });
            const option = document.createElement('option');
            option.value = newDate.toISOString().split('T')[0];
            option.textContent = dateString;
            dateSelect.appendChild(option);
        }
        const timeSelect = document.getElementById('timePicker');
        timeSelect.innerHTML = '<option value="">Select time</option>';
        const availableTimes = [];
        for (let hour = 10; hour <= 20; hour++) {
            const timeString = `${hour}:00`;
            availableTimes.push(timeString);
        }
        availableTimes.forEach(function (time) {
            const option = document.createElement('option');
            option.value = time;
            option.textContent = time;
            timeSelect.appendChild(option);
        });
        var successMessage = '@TempData["Success"]';
        var errorMessage = '@TempData["Error"]';

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: successMessage,
            });
        }
        
        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMessage,
            });
        }
        document.querySelector('form').addEventListener('submit', function (e) {
            e.preventDefault();
            Swal.fire({
                icon: 'success',
                title: 'Reservation Sent',
                text: 'Your reservation details have been submitted!',
            }).then(function () {
                e.target.submit();
            });
        });
    });
</script>

