
@model BookATableVM
<!-- Page Title #1
============================================= -->
<section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
    <div class="bg-section">
        <img src="~/assets/images/page-title/@Model.Settings["BookATableBg"]" alt="Background" />
    </div>
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="title title-1 text-center">
                    <div class="title--content">
                        <div class="title--subtitle">@Model.Settings["BookATableSubtitle"]</div>
                        <div class="title--heading">
                            <h1>@Model.Settings["BookATableHeading"]</h1>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <ol class="breadcrumb">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="active">Book A Table</li>
                    </ol>
                    <div class="divider--shape-1down"></div>
                </div>
                <!-- .title end -->
            </div>
            <!-- .col-md-12 end -->
        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #page-title end -->
<!-- Reservation #1
============================================= -->
<section id="reservation" class="reservation bg-white pb-80 pt-90">
    <div class="container">
        <div class="text-center mb-4">
            <p>@Model.Settings["ReservationDec"]</p>
        </div>
        <form method="post" asp-controller="BookATable" asp-action="MakeReservation">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <!-- Capacity Selection -->
                <div class="col-md-4">
                    <select asp-for="Capacity" class="form-control" required>
                        <option value="" disabled selected>Adam sayı</option>
                        @foreach (var table in Model.RestaurantTables)
                        {
                            <option value="@table.Capacity">@table.Capacity nəfər</option>
                        }
                    </select>

                </div>
                <!-- Date Selection -->
                <div class="col-md-4">
                    <select asp-for="Date" class="form-control" required>
                        <option value="" disabled selected>Tarix seçin</option>
                        @foreach (var date in ViewData["DateList"] as List<DateTime>)
                        {
                            <option value="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</option>
                        }
                    </select>
                </div>
                <!-- Time Selection -->
                <div class="col-md-4">
                    <select asp-for="Time" class="form-control" required>
                        <option value="" disabled selected>Vaxt seçin</option>
                        @foreach (var time in ViewData["TimeList"] as List<string>)
                        {
                            <option value="@time">@time</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <input type="text" asp-for="ContactFormModel.FirstName" class="form-control" placeholder="Ad" required />
                    <span asp-validation-for="ContactFormModel.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <input type="text" asp-for="ContactFormModel.LastName" class="form-control" placeholder="Soyad" required />
                    <span asp-validation-for="ContactFormModel.LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <input type="email" asp-for="ContactFormModel.Email" class="form-control" placeholder="Email" required />
                    <span asp-validation-for="ContactFormModel.Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <input type="text" asp-for="ContactFormModel.Phone" class="form-control" placeholder="Telefon" required />
                    <span asp-validation-for="ContactFormModel.Phone" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <textarea asp-for="ContactFormModel.Message" class="form-control" rows="4" placeholder="Mesaj" required></textarea>
                    <span asp-validation-for="ContactFormModel.Message" class="text-danger"></span>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary">Rezervasiya Et</button>
            </div>
        </form>

    </div>
</section>

<!-- #reservation1 end -->
<!-- Testimonial #5
============================================= -->
<section id="testimonial5" class="testimonial testimonial-5 bg-overlay bg-parallax bg-overlay-dark text-center">
    <div class="bg-section">
        <img src="~/assets/images/background/2.jpg" alt="Background" />
    </div>
    <div class="container">
        <div class="divider--shape-1up"></div>
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-10 col-md-offset-1">
                <div id="testimonial-wide" class="carousel carousel-white" data-slide="1" data-slide-rs="1" data-autoplay="false" data-nav="false" data-dots="false" data-space="0" data-loop="true" data-speed="800">
                    <!-- Testimonial #1 -->
                    @foreach (var item in Model.Testimonials.Take(4))
                    {
                        <div class="testimonial-panel">
                            <div class="testimonial--img">
                                <img src="~/assets/images/testimonial/chef-hat.png" alt="hat">
                            </div>
                            <div class="testimonial--body">
                                <p class="color-white">@item.Text</p>
                            </div>
                            <!-- .testimonial-body end -->
                            <div class="testimonial--meta">
                                <div class="testimonial--author">
                                    <h4>- @item.Name @item.SurName</h4>
                                </div>
                            </div>
                            <!-- .testimonial-meta end -->
                        </div>
                    }
                    <!-- .testimonial-panel end -->

                </div>
            </div>
            <!-- .col-md-12 end -->
        </div>
        <!-- .row end -->
        <div class="divider--shape-1down"></div>
    </div>
    <!-- .container end -->
</section>
<!-- .testimonial5 end -->
<!-- Banner#6
============================================= -->
<section id="banner6" class="banner banner-1 text-center pb-90">
    <div class="container">
        <div class="row">
            @foreach (var item in Model.Banners.TakeLast(3))
            {
                <div class="col-xs-12 col-sm-6 col-md-4">
                    <div class="banner-panel">
                        <div class="banner--img">
                            <img src="~/assets/images/banners/@item.Image" alt="banner img" class="img-responsive">
                        </div>
                        <div class="banner--content">
                            <h4>@item.Title</h4>
                            <p>@item.Desc</p>
                        </div>
                    </div>
                    <!-- .banner-panel end -->
                </div>
            }
            <!-- .col-md-4 end -->


        </div>
        <!-- .row end -->
    </div>
    <!-- .container end -->
</section>
<!-- #banner6 end -->
