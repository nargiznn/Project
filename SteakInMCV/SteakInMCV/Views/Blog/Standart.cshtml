@model BlogVM
        <!-- Page Title #1
        ============================================= -->
        <section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
            <div class="bg-section">
                <img src="~/assets/images/page-title/@Model.Settings["BlogBg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="title title-1 text-center">
                            <div class="title--content">
                                <div class="title--subtitle">@Model.Settings["BlogSubtitle"]</div>
                                <div class="title--heading">
                                    <h1>@Model.Settings["BlogHeading"]</h1>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <ol class="breadcrumb">
                                <li>
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li>
                                    <a asp-controller="Blog" asp-action="Standart">blog</a>
                                </li>
                                <li class="active">standard</li>
                            </ol>
                            <div class="divider--shape-1down"></div>
                        </div>
                        <!-- .title end -->
                    </div>
                    <!-- .col-md-12 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section> <!-- #page-title end -->
        <!-- Blog Standard
        ============================================= -->
        <section id="blog" class="blog blog-standard">
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-9">
                        <div class="row">
                            <!-- Blog Entry #1 -->
                            @foreach (var item in Model.EventVMs)
                            {
                                <div class="col-xs-12 col-sm-12 col-md-12">
                                    <div class="blog-entry">

                                        <div class="entry--content">
                                            <div class="entry--meta">
                                                <span>@item.CreatedDate.ToString("MMM dd, yyyy")</span>
                                                / <span>comments <a href="#">11</a></span>
                                                /@if (item.TagsName != null && item.TagsName.Any())
                                                {
                                                    <span>
                                                        @foreach (var tag in item.TagsName)
                                                        {
                                                            <span> <a href="#">@tag</a></span>
                                                            @if (tag != item.TagsName.Last())
                                                            {
                                                                <span>,</span>
                                                            }
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span></span>
                                                }
                                            </div>
                                            <div class="entry--title">
                                                <h4><a href="#">@item.Title</a></h4>
                                            </div>
                                            <div class="entry--img">
                                                <a href="#">
                                                    <img src="~/assets/images/blog/standard/@item.ImgUrl" alt="entry image" />
                                                </a>
                                            </div>
                                            <div class="entry--bio">
                                            @item.Info
                                            </div>
                                        </div>
                                        <!-- .entry-content end -->
                                    </div>
                                    <!-- .blog-entry end -->
                                </div>
                            }

                            <!-- Blog Entry #2 -->

                        </div><!-- .row end -->
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12 clearfix">
                                <ul class="pagination">
                                    <li class="active"><a href="#">1</a></li>
                                    <li><a href="#">2</a></li>
                                    <li><a href="#">3</a></li>
                                    <li>
                                        <a href="#" aria-label="Next">
                                            <span aria-hidden="true"><i class="fa fa-long-arrow-right"></i></span>
                                        </a>
                                    </li>
                                </ul>
                            </div><!-- .col-md-12 end -->
                        </div><!-- .row end -->
                    </div><!-- .col-md-9 end -->
                    <div class="col-xs-12 col-sm-12 col-md-3">
                        <!-- Search
                        ===
                        ===
                        === === === === === === === === === === === === === -->
                        <div class="widget widget-search">
                            <div class="widget--content">
                                <form class="form-search">
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="Type Your Search Words">
                                        <span class="input-group-btn">
                                            <button class="btn" type="button"><i class="fa fa-search"></i></button>
                                        </span>

                                    </div>
                                    <!-- /input-group -->
                                </form>
                            </div>
                        </div> <!-- .widget-search end -->
                        <!-- Recent Posts
                        ============================================= -->
                        <div class="widget widget-recent-posts">
                            <div class="widget--title">
                                <h5>recent blogs</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var item in Model.EventVMs.TakeLast(2))
                                {
                                    <div class="entry">
                                        <img src="~/assets/images/blog/thumb/@item.ImgUrl" alt="title" />
                                        <div class="entry-desc">
                                            <div class="entry-meta">
                                                <a href="#">@item.CreatedDate.ToString("MMM dd, yyyy")</a>
                                            </div>
                                            <div class="entry-title">
                                                <a href="#">@item.Title</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <!-- .recent-entry end -->



                            </div>
                        </div> <!-- .widget-recent end -->
                        <!-- Instagram Feed
                        ============================================= -->
                        <!--<div class="widget widget-instagram">
                            <div class="widget--title">
                                <h5>Instagram</h5>
                            </div>
                            <div class="widget--content">
                                <div id="instafeedSidebar" class="instafeed" data-insta-number="8"></div>
                                <div class="clearfix"></div>
                            </div>
                        </div>--> <!-- .widget-instagram end -->
                        <!-- Tag Clouds
                        ============================================= -->
                        <div class="widget widget-tags">
                            <div class="widget--title">
                                <h5>tag clouds</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var item in Model.EventVMs)
                                {
                                    if (item.TagsName != null && item.TagsName.Any())
                                    {
                                        foreach (var tag in item.TagsName)
                                        {
                                            <a href="#">@tag</a>
                                        }
                                    }
                                    else
                                    {
                                        <p></p>
                                    }
                                }

                            </div>
                        </div> <!-- .widget-tags end -->
                    </div><!-- .col-md-3 end -->
                </div><!-- .row end -->
            </div><!-- .container end -->
        </section><!-- #blog end -->

