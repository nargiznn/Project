@model BlogVM
        <!-- Page Title #1
        ============================================= -->
        <section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
            <div class="bg-section">
                <img src="@Model.Settings["BlogBg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="title title-1 text-center">
                            <div class="title--content">
                                <div class="title--subtitle">@Model.Settings["BlogSubtitle"]</div>
                                <div class="title--heading">
                                    <h1>@Model.Settings["BlogHeading"]</h1>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <ol class="breadcrumb">
                                <li>
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li>
                                    <a asp-controller="Blog" asp-action="Standart">blog</a>
                                </li>
                                <li class="active">standard</li>
                            </ol>
                            <div class="divider--shape-1down"></div>
                        </div>
                        <!-- .title end -->
                    </div>
                    <!-- .col-md-12 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section> <!-- #page-title end -->
        <!-- Blog Standard
        ============================================= -->
        <section id="blog" class="blog blog-standard">
            <div class="container">
                <div class="row">

                    <div class="col-xs-12 col-sm-12 col-md-9">
                        <div class="row">
                            <!-- Blog Entry #1 -->
                            @foreach (var item in Model.EventVMs)
                            {
                                <div class="col-xs-12 col-sm-12 col-md-12">
                                    <div class="blog-entry">

                                        <div class="entry--content">
                                            <div class="entry--meta">
                                                <span>@item.CreatedDate.ToString("MMM dd, yyyy")</span>
                                                /@if (item.TagsName != null && item.TagsName.Any())
                                                {
                                                    <span>
                                                        @foreach (var tag in item.TagsName)
                                                        {
                                                            <span> <a href="#">@tag</a></span>
                                                            @if (tag != item.TagsName.Last())
                                                            {
                                                                <span>,</span>
                                                            }
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span></span>
                                                }
                                            </div>
                                            <div class="entry--title">
                                                <h4><a href="#">@item.Title</a></h4>
                                            </div>
                                            <div class="entry--img">
                                                <a asp-controller="Blog" asp-action="Single" asp-route-id="@item.Id">
                                                    <img src="@item.ImgUrl" alt="entry image" style="width: 800px; height: 500px; object-fit: cover;" />
                                                </a>


                                            </div>
                                            <div class="entry--bio">
                                                @item.Info
                                            </div>
                                        </div>
                                        <!-- .entry-content end -->
                                    </div>
                                    <!-- .blog-entry end -->
                                </div>
                            }


                            <!-- Blog Entry #2 -->

                        </div><!-- .row end -->
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12 clearfix">
                                <ul class="pagination">
                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        if (ViewBag.PageIndex == i)
                                        {
                                            <li class="active"><a href="#">@i</a></li>
                                        }
                                        else
                                        {
                                            <li><a asp-route-page="@i">@i</a></li>
                                        }
                                    }

                                    @if (ViewBag.PageIndex < ViewBag.TotalPages)
                                    {
                                        <li>
                                            <a asp-route-page="@(ViewBag.PageIndex + 1)" aria-label="Next">
                                                <span aria-hidden="true"><i class="fa fa-long-arrow-right"></i></span>
                                            </a>
                                        </li>
                                    }

                                 
                                </ul>
                            </div>
                        </div>


                    </div><!-- .col-md-9 end -->
                    <div class="col-xs-12 col-sm-12 col-md-3">

                        <!-- Recent Posts
                        ============================================= -->
                        <div class="widget widget-recent-posts">
                            <div class="widget--title">
                                <h5>recent blogs</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var item in Model.EventVMs.TakeLast(2))
                                {
                                    <div class="entry">
                                        <img src="@item.ImgUrl" alt="title" style="width: 49px; height: 49px; object-fit: cover;" />
                                        <div class="entry-desc">
                                            <div class="entry-meta">
                                                <a asp-controller="Blog" asp-action="Single" asp-route-id="@item.Id">@item.CreatedDate.ToString("MMM dd, yyyy")</a>
                                            </div>
                                            <div class="entry-title">
                                                <a asp-controller="Blog" asp-action="Single" asp-route-id="@item.Id">@item.Title</a>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- .recent-entry end -->

                            </div>
                        </div> <!-- .widget-recent end -->

                        <div class="widget widget-tags">
                            <div class="widget--title">
                                <h5>tag clouds</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var item in Model.EventVMs)
                                {
                                    if (item.TagsName != null && item.TagsName.Any())
                                    {
                                        foreach (var tag in item.TagsName)
                                        {
                                            <a href="#">@tag</a>
                                        }
                                    }
                                    else
                                    {
                                        <p></p>
                                    }
                                }

                            </div>
                        </div> <!-- .widget-tags end -->
                    </div><!-- .col-md-3 end -->
                </div><!-- .row end -->
            </div><!-- .container end -->
        </section><!-- #blog end -->

