@model BlogVM
        <!-- Page Title #1
        ============================================= -->
        <section id="page-title" class="page-title bg-overlay bg-parallax bg-overlay-gradient">
            <div class="bg-section">
                <img src="@Model.Settings["SingleBlogBg"]" alt="Background" />
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="title title-1 text-center">
                            <div class="title--content">
                                <div class="title--subtitle">@Model.Settings["BlogSubtitle"]</div>
                                <div class="title--heading">
                                    <h1>@Model.Settings["BlogSingleSubtitle"]</h1>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <ol class="breadcrumb">
                                <li>
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li>
                                    <a asp-controller="Blog" asp-action="Standart">blog</a>
                                </li>
                                <li class="active">Single Post</li>
                            </ol>
                            <div class="divider--shape-1down"></div>
                        </div>
                        <!-- .title end -->
                    </div>
                    <!-- .col-md-12 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <!-- #page-title end -->
        <!-- Blog Single Right Sidebar
        ============================================= -->
        <section id="blog" class="blog blog-single">
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-9">
                        <!-- Blog Entry -->
                        <div class="blog-entry">

                            <div class="entry--content">
                                <div class="entry--meta">
                                    <span>@Model.EventVM.CreatedDate.ToString("MMM dd, yyyy")</span> /
                                    <span>comments <a href="#">11</a></span> /

                                    @if (Model.EventVM.TagsName != null && Model.EventVM.TagsName.Any())
                                    {
                                        <span>
                                            @foreach (var tag in Model.EventVM.TagsName)
                                            {
                                                <a href="#">@tag</a>
                                                @if (tag != Model.EventVM.TagsName.Last())
                                                {
                                                    <span>, </span>
                                                }
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                </div>


                                <div class="entry--title">
                                    <h4><a href="#">@Model.EventVM.Title</a></h4>
                                </div>
                                <div class="entry--img">
                                    <a href="#">
                                        <img src="~/assets/images/blog/standard/1.jpg" alt="entry image" />
                                    </a>
                                </div>
                                <div class="entry--bio">
                                    <p>
                                        @Model.EventVM.Info
                                    </p>
                                </div>
                                <!-- .entry-share end -->
                            </div>
                        </div>
                        <!-- .entry-bio end -->

                        <div class="entry-widget entry-related clearfix">
                            <div class="entry-widget-title">
                                <h4>related posts</h4>
                            </div>
                            <div class="entry-widget-content">
                                <div class="row">
                                    <!-- Related Post #1 -->
                                    @foreach (var item in Model.EventVMs.Where(p => p.TagsName.Any(tag => Model.EventVM.TagsName.Contains(tag))).Take(3))
                                    {
                                        <div class="col-xs-12 col-sm-4 col-md-4 entry">
                                            <div class="entry--img">
                                                <a asp-controller="Blog" asp-action="Single" asp-route-id="@item.Id">
                                                    <img src="@item.ImgUrl" style="width: 100px; height: 100px; object-fit: cover;" alt="title" />
                                                </a>
                                            </div>
                                            <div class="entry--title">
                                                <h5><a href="#">@item.Title</a></h5>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <!-- .row end -->
                            </div>
                        </div>

                        <div class="entry-widget entry-comments clearfix">
                            <div class="entry-widget-title">
                                <h4>Comments</h4>
                            </div>
                            <div class="entry-widget-content">
                                <ul class="comments-list">
                                    @foreach (var comment in Model.Comments)
                                    {
                                        <li class="comment-body">
                                            <div class="avatar">
                                                <img src="~/assets/images/team/thumb/2.jpg" alt="avatar" />
                                            </div>
                                            <div class="comment">
                                                <h6>@comment.AuthorName</h6>
                                                <div class="date">@comment.CreatedDate.ToString("MMM dd, yyyy - hh:mm tt")</div> 
                                                <p>@comment.Content</p>
                                                <a class="reply" href="javascript:void(0)" data-comment-id="@comment.Id">Reply</a>
                                            </div>
                                            @if (comment.Replies != null && comment.Replies.Any())
                                            {
                                                <ul class="comment-children">
                                                    @foreach (var reply in comment.Replies)
                                                    {
                                                        <li class="comment-body">
                                                            <div class="avatar">
                                                                <img src="~/assets/images/team/thumb/2.jpg" alt="avatar" />
                                                            </div>
                                                            <div class="comment">
                                                                <h6>@reply.AuthorName</h6>
                                                                <div class="date">@reply.CreatedDate.ToString("MMM dd, yyyy - hh:mm tt")</div> 
                                                                <p>@reply.Content</p>
                                                                <a class="reply" href="javascript:void(0)" data-comment-id="@reply.Id">Reply</a>
                                                            </div>

                                                            @if (reply.Replies != null && reply.Replies.Any())
                                                            {
                                                                <ul class="comment-children">
                                                                    @foreach (var replyToReply in reply.Replies)
                                                                    {
                                                                        <li class="comment-body">
                                                                            <div class="avatar">
                                                                                <img src="~/assets/images/team/thumb/2.jpg" alt="avatar" />
                                                                            </div>
                                                                            <div class="comment">
                                                                                <h6>@replyToReply.AuthorName</h6>
                                                                                <div class="date">@replyToReply.CreatedDate.ToString("MMM dd, yyyy - hh:mm tt")</div> 
                                                                                <p>@replyToReply.Content</p>
                                                                                <a class="reply" href="javascript:void(0)" data-comment-id="@replyToReply.Id">Reply</a>
                                                                            </div>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                    </div>
                    <!-- .col-md-9 end -->
                    <div class="col-xs-12 col-sm-12 col-md-3">
                        <!-- Recent Posts
    ============================================= -->
                        <div class="widget widget-recent-posts">
                            <div class="widget--title">
                                <h5>recent posts</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var item in Model.EventVMs.TakeLast(2))
                                {
                                    <div class="entry">
                                        <img src="@item.ImgUrl" alt="title" style="width: 49px; height: 49px; object-fit: cover;" />
                                        <div class="entry-desc">
                                            <div class="entry-meta">
                                                <a asp-controller="Blog" asp-action="Single" asp-route-id="@item.Id">@Model.EventVM.CreatedDate.ToString("MMM dd, yyyy")</a>
                                            </div>
                                            <div class="entry-title">
                                                <a asp-controller="Blog" asp-action="Single" asp-route-id="@item.Id">@item.Title</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <!-- .recent-entry end -->


                            </div>
                        </div> <!-- .widget-recent end -->
                        <div class="widget widget-tags">
                            <div class="widget--title">
                                <h5>tag clouds</h5>
                            </div>
                            <div class="widget--content">
                                @foreach (var tag in Model.EventVM.TagsName)
                                {
                                    <a href="#">@tag</a>
                                }
                            </div>
                        </div> <!-- .widget-tags end -->

                    </div>
                    <!-- .col-md-3 end -->
                </div>
                <!-- .row end -->
            </div>
            <!-- .container end -->
        </section>
        <!-- #blog end -->

